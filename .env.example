NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google OAuth. Configure these same values in Supabase Auth -> Providers -> Google.

# Optional server-side transcript provider used for YouTube listening activities.
# Leave empty to use public caption retrieval + manual transcript fallback.
SUPADATA_API_KEY=

# Use mock output for local demos without a real OpenAI key.
MOCK_OPENAI=false

# Optional analytics. If unset, analytics becomes a safe no-op/dev console event.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Comma-separated owner emails that can view the simple feedback admin list.

# Optional feedback email notifications. If unset, feedback is saved in Supabase only.
RESEND_API_KEY=
FEEDBACK_NOTIFICATION_EMAIL=
FEEDBACK_FROM_EMAIL=
